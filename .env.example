# Non-secret configuration only. Secrets are files in secrets/ (see bottom).

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Origin the browser uses; Better Auth cookies and CORS are bound to it.
PUBLIC_URL=http://127.0.0.1:8080
# Serve the API reference at /api/v1/docs (never in production).
API_DOCS=on

PROXY_BIND=127.0.0.1
PROXY_PORT=8080
SITE_ADDRESS=:8080

DB_DEV_PORT=5432
API_DEV_PORT=3000

API_DB_POOL_MAX=10
WORKER_DB_POOL_MAX=10

IMAGE_TAG=local

# Daraja sandbox. Public test shortcodes: M-Pesa Express 174379, C2B 600984.
DARAJA_SHORTCODE=174379
DARAJA_C2B_SHORTCODE=600984
# Public tunnel URL for sandbox callbacks (make tunnel, then make tunnel-url).
CALLBACK_BASE_URL=
# Initiator (API operator) for Transaction Status and Account Balance: the sandbox app's
# test credentials; the password goes in secrets/daraja_initiator_password. Empty disables both.
DARAJA_INITIATOR_NAME=testapi
# Comma-separated source IPs allowed to call /hooks; empty disables the check (sandbox).
# Production: Safaricom's gateway IPs from the Daraja portal (Getting Started), confirmed with Safaricom.
CALLBACK_ALLOWED_IPS=
NGROK_INSPECT_PORT=4040

# --- Secret files (secrets/<name>, generated for dev by `make secrets`) ---
#   postgres_superuser_password   db superuser (db container + tests only)
#   db_migrator_password          paysync_migrator (migrate)
#   db_app_password               paysync_app (api, worker)
#   db_readonly_password          paysync_readonly (BI / debugging)
#   better_auth_secret            Better Auth signing secret (api)
#   callback_path_secret          secret path segment of the Daraja callback URLs
#   data_encryption_key           32-byte hex key: personal data and the Daraja token
#   daraja_consumer_key / daraja_consumer_secret / daraja_passkey   from your Daraja sandbox app
#   daraja_initiator_password     initiator password; encrypted with Safaricom's certificate at start (worker)
#   ngrok_authtoken               for make tunnel (sandbox only)
# Added in later milestones, same pattern:
#   typesafe_api_key (M6)
