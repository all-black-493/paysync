  {
    "name": "list_exceptions",
    "description": "List reconciliation exceptions. The main work queue: payments the system could not match confidently (no match, partial or over payment, duplicate, failed verification, amount mismatch). Defaults to open exceptions, oldest first so nothing waits forever.",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "requiredScopes": [
      "paysync:read"
    ],
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "default": "open",
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "dismissed"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "no_match",
            "low_confidence",
            "partial_payment",
            "overpayment",
            "duplicate",
            "verification_failed",
            "amount_mismatch",
            "balance_variance",
            "job_failed",
            "missing_callback",
            "reversal_failed"
          ]
        },
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "Opaque cursor from a previous page (`nextCursor`).",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    }
  },
