[
  {
    "name": "annotate_exception",
    "description": "Add a note or tags to an exception. Sets the note and/or replaces the tags on an exception so the next person (or agent) has context. Does not resolve the exception and does not move money. Pass the version you read.",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "requiredScopes": [
      "paysync:read",
      "paysync:write"
    ],
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "maxLength": 2000
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Unique per logical action. Retrying with the same key returns the original result."
        },
        "dryRun": {
          "default": false,
          "description": "Validate and preview the change without writing it.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version",
        "idempotencyKey"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "confirm_match",
    "description": "Match a payment to expected payments. Allocates a verified payment to one or more open expected payments (split payments allowed) and closes its no_match, low_confidence, duplicate, partial_payment and overpayment exceptions. Each amount must fit what is still due, and the total must fit what is unallocated; the rest stays unallocated. Pass the transaction version you read; if it changed you get STALE_STATE. Only verified payments can be matched. Use matches.suggest first to find candidates.",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "requiredScopes": [
      "paysync:read",
      "paysync:write"
    ],
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "maxLength": 2000
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "allocations": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expectedPaymentId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "maxLength": 2000
              },
              "amount": {
                "$ref": "#/$defs/Money"
              }
            },
            "required": [
              "expectedPaymentId",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Unique per logical action. Retrying with the same key returns the original result."
        },
        "dryRun": {
          "default": false,
          "description": "Validate and preview the change without writing it.",
          "type": "boolean"
        }
      },
      "required": [
        "transactionId",
        "version",
        "allocations",
        "idempotencyKey"
      ],
      "additionalProperties": false,
      "$defs": {
        "Money": {
          "type": "object",
          "properties": {
            "minor": {
              "type": "string",
              "pattern": "^[0-9]{1,16}$",
              "maxLength": 2000
            },
            "currency": {
              "type": "string",
              "const": "KES"
            }
          },
          "required": [
            "minor",
            "currency"
          ],
          "additionalProperties": false,
          "description": "Amount in minor units (1 KES = 100) as an integer string."
        }
      }
    }
  },
  {
    "name": "create_expected_payment",
    "description": "Create an expected payment. Records something the business expects to be paid, such as an invoice. The reference must be unique in the organization after normalization (case, spaces and punctuation are ignored). Use dryRun to validate first. Does not move money.",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "requiredScopes": [
      "paysync:read",
      "paysync:write"
    ],
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[A-Za-z0-9]"
        },
        "amountDue": {
          "$ref": "#/$defs/Money"
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "payerLabel": {
          "type": "string",
          "maxLength": 120
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Unique per logical action. Retrying with the same key returns the original result."
        },
        "dryRun": {
          "default": false,
          "description": "Validate and preview the change without writing it.",
          "type": "boolean"
        }
      },
      "required": [
        "reference",
        "amountDue",
        "idempotencyKey"
      ],
      "additionalProperties": false,
      "$defs": {
        "Money": {
          "type": "object",
          "properties": {
            "minor": {
              "type": "string",
              "pattern": "^[0-9]{1,16}$",
              "maxLength": 2000
            },
            "currency": {
              "type": "string",
              "const": "KES"
            }
          },
          "required": [
            "minor",
            "currency"
          ],
          "additionalProperties": false,
          "description": "Amount in minor units (1 KES = 100) as an integer string."
        }
      }
    }
  },
