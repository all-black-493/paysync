{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	try_files {path} /index.html
	file_server

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}
